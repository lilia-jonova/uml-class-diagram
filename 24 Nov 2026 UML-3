@startuml
Entity Клиент
{
ФИО_клиента
Номер_телефона_клиента
}
Entity Меню
{
Вид_меню
}

Entity Категории_меню
{
Наименование_категории_меню
}

Категории_меню "1.." --o "1.." Меню 

Entity Категория_товара
{
Наименование_категории_товара
}

Категория_товара "1.." -- "1.." Категория_товара

Entity Товары
{
Тип_товара
Наименование
Фото_несколько
Описание
Калорийность
БЖУ
Тех_карта
Стоимость
Категория_товара
}

Товары "1.." --o "1.." Категория_товара
Товары "1.." -- "1.." Категории_меню
Товары "1.." --o "1.." Товары

Entity Список_товаров_в_корзине
{
Порядковый_номер_товара
Наименование_товара
Количество_товара
}

Товары "1.." -- "1.." Список_товаров_в_корзине




Entity Тип_Комбобургер
{
Стоимость_комбобургера_без_наценки
Наценка_на_комбо
}
   
Тип_Комбобургер  --^  Товары


Entity Ингредиенты
{
Тип_ингредиента
Наименование_ингредиента
Единицы_измерения
Стоимость_за_единицу
Технология_приготовления
}

Entity Тип_Ингредиенты_комбобургер
{
Стоимость_ингредиента_в_комбобургере
Обязательность
Ограничение_на_количество
}
Тип_Ингредиенты_комбобургер  --^ Ингредиенты

Entity Тех_карта 
{
Раскладка_ингредиентов
Ингредиенты
}

Ингредиенты "1.." --o "1.." Тех_карта
Тех_карта "1" --o "1"  Товары

Entity Корзина
{
Список_товаров_в_корзине
Общая_стоимость_корзины
}

Список_товаров_в_корзине "1.." --* "1" Корзина

Entity Оплата
{
Способ_оплаты
Номер_платежа
Печать_чека
}


Entity Оплата_картой
{
Банковский_терминал
Данные_карты_клиента
Банк_для_платежа
Номер_платежа
Оплата_статус
}
Оплата_картой --^ Оплата

Entity Оплата_наличными
{
Банкноты
Купюроприемник
Номер_платежа
Оплата_статус
}
Оплата_наличными --^ Оплата

Entity Оплата_баллами
{
Номер_телефона_клиента
Вариант_шлюза_смс
Количество_баллов_клиента_в_слояльности
Общая_стоимость_корзины
Номер_платежа
Оплата_статус
}
Оплата_баллами --^ Оплата

Entity Заказ
{
Заказ_статус
Дата
Номер_заказа
Клиент
}
Категория_товара "1.." -- "1.." Категории_меню
Оплата "1.." -- "1" Заказ
Корзина  ^--  Заказ
Клиент "0..1" -- "1.." Заказ 

@enduml
